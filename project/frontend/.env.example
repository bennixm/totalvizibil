# Base URL of the backend API (includes the version prefix).
# Relative by default: in dev it goes through the Vite proxy (see vite.config.ts),
# in prod the app is served behind a reverse proxy at the same origin.
# Set an absolute URL only to point at a different host.
VITE_API_BASE_URL=/api/v1

# Default application locale when the visitor has no stored preference (ro | en | de)
VITE_DEFAULT_LOCALE=ro
