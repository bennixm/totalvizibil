# This file is a TEMPLATE, committed to git — every value below must stay a
# placeholder. Real secrets go in your local `.env` (gitignored, copy this
# file to that name and fill it in there). Anything real typed into THIS
# file becomes permanently visible in git history the moment it's pushed,
# even if you later blank it out again in a follow-up commit.

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database (matches project/docker-compose.yml) ---
DATABASE_URL="postgresql://tvz:tvz@localhost:5432/tvz?schema=public"

# --- Auth ---
# Cookie name for the session token.
SESSION_COOKIE_NAME=tvz_session
# Session lifetime in days.
SESSION_TTL_DAYS=30
# Set true only when served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- CORS ---
# Origin of the frontend dev server (Vite).
FRONTEND_ORIGIN=https://dev.totalvizibil.ro

# --- AI (Claude / Anthropic) — the ONLY AI provider ---
# Powers: the Simple-site "Services copy" call + the end-of-setup text review, and
# the Advanced builder's full generation pipeline ("generate site from a prompt").
# Leave empty to run fully deterministic (keyword plans + templated copy) — every
# flow still completes, just without AI nuance.
# Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
# Model id for the "smart" calls (business analysis, information architecture,
# structure plan). claude-sonnet-5 is recommended — claude-opus-5 gives the best
# structure but the Advanced generator's ~8-call chain can time out on it.
ANTHROPIC_MODEL=claude-sonnet-5
# Faster/cheaper model for the high-volume mechanical calls (page copy, section
# rewrites, image intents, reviews). Empty = claude-sonnet-5.
ANTHROPIC_MODEL_FAST=

# --- Website builder: stock photos (Pexels) ---
# Primary photo provider for the Advanced builder's AI generator. Empty = fall
# back to the built-in curated pool. Free key at https://www.pexels.com/api/.
PEXELS_API_KEY=

# --- PRO V2: cheaper-tier model routing (optional) ---
# DeepSeek is used only by PRO V2's cost-aware router, for simple edits/repairs
# it deems safe to try before falling back to Claude. Empty = PRO V2 routes
# everything to Claude, exactly like today. Key at https://platform.deepseek.com.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_FLASH=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-reasoner

# --- Google Ads: real-time CPC feed pricing (optional) ---
# Replaces the old manual "Cost promovare" admin setting for feed clicks
# attributed to a Google Ads referral (?gclid=...): a background job polls
# the Google Ads API for the rolling-average CPC and uses it instead of a
# flat admin-set number, so that traffic is priced at roughly what it
# actually costs to acquire. ALL of these are required together — if any one
# is empty, the sync job logs once and stays idle (never crashes the app).
#
# GOOGLE_ADS_DEVELOPER_TOKEN — from the Google Ads API Center (Tools & Settings
#   > Setup > API Center) on the manager (MCC) account. One token for the
#   whole MCC; needs at least "Basic Access" approval from Google to pull
#   real (non-test) data — that approval can take a few days.
# GOOGLE_ADS_CLIENT_ID / GOOGLE_ADS_CLIENT_SECRET — OAuth2 client credentials
#   from a Google Cloud project (APIs & Services > Credentials > OAuth client
#   ID, type "Desktop app" or "Web application").
# GOOGLE_ADS_REFRESH_TOKEN — obtained ONCE via an OAuth consent flow
#   authorizing that Cloud project against the Google Ads account; then
#   reused indefinitely (doesn't expire under normal use). Not something you
#   copy from a settings page — generated via a short one-time script/flow.
# GOOGLE_ADS_CUSTOMER_ID — the Google Ads account id running the campaign
#   (format 123-456-7890, digits only here, no dashes).
# GOOGLE_ADS_LOGIN_CUSTOMER_ID — only if the account above is managed through
#   an MCC: the MCC's own customer id. Leave empty otherwise.
# GOOGLE_ADS_CAMPAIGN_ID — the specific campaign promoting the platform.
#   Empty = averages cost/clicks across the WHOLE account, which silently
#   goes wrong the moment any other campaign exists on the same account.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CAMPAIGN_ID=

# --- Payments: Stripe (test mode) ---
# Secret key for Stripe TEST mode (starts with sk_test_...). Empty = wallet
# top-ups keep using the dev stub (an instant "confirm" button, no real
# charge) and refunds are unavailable (nothing real to refund).
# Get test keys at https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=

# --- Email: SMTP ---
# Empty = outgoing mail stays dev-logged only (nothing is ever faked as sent).
# Works with any SMTP provider (Gmail app password for local testing, or a
# real mailbox in production). Port 465 = implicit TLS; anything else
# (587, 25) = STARTTLS — MailService picks the right mode from SMTP_PORT.
#
# Real credentials go in the local, gitignored .env — NEVER in this file.
# This file is committed to git; anything filled in here is permanently
# exposed in history the moment it's pushed, not just in the current diff.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Empty = SMTP_USER.
SMTP_FROM=

# --- Website builder: post-generation visual QA (opt-in) ---
# When "on" AND a screenshot of the rendered site can be obtained, the generator
# runs a Claude-vision review of the result and applies targeted fixes. Empty/off
# = skip (deterministic + text review still run).
VISUAL_QA=
# Dev-only: URL of a service that returns a PNG screenshot for a given site URL.
# Empty = visual QA no-ops.
SCREENSHOT_URL=
