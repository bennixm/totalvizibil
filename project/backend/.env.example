# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database (matches project/docker-compose.yml) ---
DATABASE_URL="postgresql://tvz:tvz@localhost:5432/tvz?schema=public"

# --- Auth ---
# Cookie name for the session token.
SESSION_COOKIE_NAME=tvz_session
# Session lifetime in days.
SESSION_TTL_DAYS=30
# Set true only when served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- CORS ---
# Origin of the frontend dev server (Vite).
FRONTEND_ORIGIN=http://localhost:5173

# --- AI (Claude / Anthropic) ---
# Primary AI for both website builders. Powers: the Simple-site "Services copy"
# call + the end-of-setup text review, and the Advanced builder's "Generate site
# from a prompt" / "Tweak section with AI".
# Leave empty to fall back to DEEPSEEK_API_KEY, then to fully deterministic
# (keyword plans + templated copy).
# Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=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
# Model id for the builders. Default: claude-opus-5. Other options:
# claude-sonnet-5 (cheaper/faster generation), claude-haiku-4-5 (cheapest — good
# for the review / proofread pass).
ANTHROPIC_MODEL=claude-opus-5

# --- AI (DeepSeek) — legacy secondary fallback ---
# Used only when ANTHROPIC_API_KEY is not set. Same call sites, same behaviour.
# Get a key at https://platform.deepseek.com/ (model used: deepseek-chat).
DEEPSEEK_API_KEY=
