# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database (matches project/docker-compose.yml) ---
DATABASE_URL="postgresql://tvz:tvz@localhost:5432/tvz?schema=public"

# --- Auth ---
# Cookie name for the session token.
SESSION_COOKIE_NAME=tvz_session
# Session lifetime in days.
SESSION_TTL_DAYS=30
# Set true only when served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- CORS ---
# Origin of the frontend dev server (Vite).
FRONTEND_ORIGIN=http://localhost:5173

# --- AI (DeepSeek) ---
# Powers: the Simple-site "Services copy" call, grammar proofreading, and the
# Advanced builder's "Generate site from a prompt" / "Tweak section with AI".
# Leave empty to run fully deterministic (keyword plans + templated copy).
# Get a key at https://platform.deepseek.com/ (model used: deepseek-chat).
DEEPSEEK_API_KEY=
