# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database (matches project/docker-compose.yml) ---
DATABASE_URL="postgresql://tvz:tvz@localhost:5432/tvz?schema=public"

# --- Auth ---
# Cookie name for the session token.
SESSION_COOKIE_NAME=tvz_session
# Session lifetime in days.
SESSION_TTL_DAYS=30
# Set true only when served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- CORS ---
# Origin of the frontend dev server (Vite).
FRONTEND_ORIGIN=http://localhost:5173

# --- AI (Claude / Anthropic) — the ONLY AI provider ---
# Powers: the Simple-site "Services copy" call + the end-of-setup text review, and
# the Advanced builder's full generation pipeline ("generate site from a prompt").
# Leave empty to run fully deterministic (keyword plans + templated copy) — every
# flow still completes, just without AI nuance.
# Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
# Model id for the "smart" calls (business analysis, information architecture,
# structure plan). claude-sonnet-5 is recommended — claude-opus-5 gives the best
# structure but the Advanced generator's ~8-call chain can time out on it.
ANTHROPIC_MODEL=claude-sonnet-5
# Faster/cheaper model for the high-volume mechanical calls (page copy, section
# rewrites, image intents, reviews). Empty = claude-sonnet-5.
ANTHROPIC_MODEL_FAST=

# --- Website builder: stock photos (Pexels) ---
# Primary photo provider for the Advanced builder's AI generator. Empty = fall
# back to the built-in curated pool. Free key at https://www.pexels.com/api/.
PEXELS_API_KEY=

# --- PRO V2: cheaper-tier model routing (optional) ---
# DeepSeek is used only by PRO V2's cost-aware router, for simple edits/repairs
# it deems safe to try before falling back to Claude. Empty = PRO V2 routes
# everything to Claude, exactly like today. Key at https://platform.deepseek.com.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_FLASH=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-reasoner

# --- Payments: Stripe (test mode) ---
# Secret key for Stripe TEST mode (starts with sk_test_...). Empty = wallet
# top-ups keep using the dev stub (an instant "confirm" button, no real
# charge) and refunds are unavailable (nothing real to refund).
# Get test keys at https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=
# --- Email: SMTP (Gmail, for testing) ---
# Empty = outgoing mail stays dev-logged only (nothing is ever faked as sent).
# For Gmail: enable 2-Step Verification on the account, then create an App
# Password (myaccount.google.com/apppasswords) — use that as SMTP_PASS, not
# the account password itself.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Empty = SMTP_USER.
SMTP_FROM=

# --- Website builder: post-generation visual QA (opt-in) ---
# When "on" AND a screenshot of the rendered site can be obtained, the generator
# runs a Claude-vision review of the result and applies targeted fixes. Empty/off
# = skip (deterministic + text review still run).
VISUAL_QA=
# Dev-only: URL of a service that returns a PNG screenshot for a given site URL.
# Empty = visual QA no-ops.
SCREENSHOT_URL=
