// Totalvizibil — database schema.
// Milestone 1 (Company Foundation): a faithful subset of PRD §16.1–16.3.
// Later milestones add websites, campaigns, ledger, analytics, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  passwordHash      String     @map("password_hash")
  name              String
  status            UserStatus @default(active)
  lastLoginAt       DateTime?  @map("last_login_at")
  passwordChangedAt DateTime?  @map("password_changed_at")

  // TOTP (RFC 6238) two-factor. `totpSecret` is set at setup time but 2FA only
  // enforces once `totpEnabledAt` is non-null (i.e. a code was verified).
  totpSecret    String?   @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions                Session[]
  platformRoles           PlatformRoleAssignment[]
  companyMembers          CompanyUser[]
  ownedCompanies          Company[]                @relation("CompanyOwner")
  passwordResets          PasswordResetToken[]
  wallet                  Wallet?
  billingProfile          BillingProfile?
  invoices                Invoice[]
  supportTicketsRequested SupportTicket[]          @relation("SupportRequester")
  supportTicketsAssigned  SupportTicket[]          @relation("SupportAssignee")
  supportMessages         SupportMessage[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum PlatformRole {
  admin
  support
  finance
  moderator
}

model PlatformRoleAssignment {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      PlatformRole
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("platform_roles")
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  slug      String   @unique
  // { "ro": "...", "en": "...", "de": "..." }
  nameI18n  Json     @map("name_i18n")
  icon      String?
  isActive  Boolean  @default(true) @map("is_active")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  companies Company[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Company
// ---------------------------------------------------------------------------

enum CompanyStatus {
  draft
  active
  suspended
}

model Company {
  id            String        @id @default(uuid()) @db.Uuid
  legalName     String?       @map("legal_name")
  displayName   String        @map("display_name")
  slug          String        @unique
  description   String?
  categoryId    String?       @map("category_id") @db.Uuid
  logoUrl       String?       @map("logo_url")
  status        CompanyStatus @default(draft)
  country       String        @default("RO")
  defaultLocale String        @default("ro") @map("default_locale")
  currency      String        @default("RON")
  ownerUserId   String        @map("owner_user_id") @db.Uuid
  claimedAt     DateTime?     @map("claimed_at")

  // Feed ranking inputs (PRD §8). Cached, recomputed on profile changes.
  // `featured` stands in for "has an active sponsored campaign" until the
  // campaigns/credit tables land — it only drives the "sponsored" placement slot.
  qualityScore Float   @default(0) @map("quality_score")
  featured     Boolean @default(false)

  // Advanced website builder — one-time paid unlock (spec: "Plata Planului Avansat").
  advancedUnlockedAt DateTime? @map("advanced_unlocked_at")

  // Whole-business deletion is deferred: this is stamped on a delete request,
  // the listing is taken down immediately, and the row (site, campaign, leads…)
  // is purged only after the grace window. The owner can cancel until then.
  deletionScheduledAt DateTime? @map("deletion_scheduled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category           Category?           @relation(fields: [categoryId], references: [id])
  owner              User                @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  members            CompanyUser[]
  locations          CompanyLocation[]
  contacts           CompanyContact[]
  services           CompanyService[]
  website            Website?
  campaign           Campaign?
  walletTransactions WalletTransaction[]
  adClicks           AdClick[]
  leads              Lead[]
  supportTickets     SupportTicket[]

  @@index([ownerUserId])
  @@index([categoryId])
  @@index([status])
  @@map("companies")
}

// ---------------------------------------------------------------------------
// Website (PRD §11) — one per company. Content is a typed block tree stored
// as JSON for now; normalised page/section tables come in a later milestone.
// ---------------------------------------------------------------------------

enum WebsiteMode {
  easy
  advanced
}

enum WebsiteStatus {
  draft
  published
  unpublished
}

model Website {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @unique @map("company_id") @db.Uuid
  mode        WebsiteMode   @default(easy)
  status      WebsiteStatus @default(draft)
  // { palette, fontPair, radius, density }
  theme       Json
  // { pages: [{ slug, title, isHome, sections: [{ type, ...content }] }], seo: {...} }
  content     Json
  generator   String        @default("rule-based-v1")
  // Advanced builder inputs (AdvancedInput), so re-opening the builder restores state.
  builderSpec Json?         @map("builder_spec")
  // Scripted advanced-builder conversation transcript.
  builderChat Json?         @map("builder_chat")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("websites")
}

// ---------------------------------------------------------------------------
// Website draft (AI studio) — an anonymous, pre-account one-pager built by the
// scripted assistant on the free plan. Identified by an opaque token (only the
// SHA-256 hash is stored). It is "claimed" into a real Website once the visitor
// creates an account (later milestone).
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Website assets — client-uploaded images for the "Site Simplu" builder (the
// landing background + up to 10 portfolio images). Stored as bytes in Postgres
// (there is no blob store yet). Held against the anonymous draft first, then
// re-pointed to the company when the draft is claimed. Referenced from the
// content JSON only by URL (`/api/v1/website-assets/:id`), never inlined.
// ---------------------------------------------------------------------------
model WebsiteAsset {
  id        String   @id @default(uuid()) @db.Uuid
  draftId   String?  @map("draft_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  kind      String // "landing" | "portfolio"
  mime      String
  bytes     Bytes
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([draftId])
  @@index([companyId])
  @@map("website_assets")
}

enum WebsiteDraftStatus {
  in_progress
  ready
  claimed
}

model WebsiteDraft {
  id        String             @id @default(uuid()) @db.Uuid
  tokenHash String             @unique @map("token_hash")
  mode      WebsiteMode        @default(easy)
  plan      String             @default("free")
  status    WebsiteDraftStatus @default(in_progress)

  // Scripted-assistant progress.
  step       String @default("business")
  answers    Json   @default("{}")
  transcript Json   @default("[]")
  turnsUsed  Int    @default(0) @map("turns_used")

  // Generated output (block tree + theme) — null until the first generation pass.
  theme     Json?
  content   Json?
  generator String?

  // Exact-niche category (leaf slug from the 2-level taxonomy). Chosen on the
  // location step; copied onto the Company at claim time. A business must have
  // one to appear in the feed.
  categorySlug String? @map("category_slug")

  // Location step (M2) — the service area that decides where the company can
  // surface in the feed. Populated after the one-pager is generated.
  locationCity       String? @map("location_city")
  locationRegion     String? @map("location_region")
  locationCountry    String? @map("location_country")
  locationLat        Float?  @map("location_lat")
  locationLng        Float?  @map("location_lng")
  locationRadiusKm   Int?    @map("location_radius_km")
  // Serves the whole country — no radius; the feed matches it for any area.
  locationNationwide Boolean @default(false) @map("location_nationwide")

  claimedCompanyId String? @unique @map("claimed_company_id") @db.Uuid

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("website_drafts")
}

enum CompanyRole {
  owner
  manager
  editor
  billing
}

enum CompanyMemberStatus {
  active
  invited
  removed
}

model CompanyUser {
  id        String              @id @default(uuid()) @db.Uuid
  companyId String              @map("company_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  role      CompanyRole
  status    CompanyMemberStatus @default(active)
  invitedBy String?             @map("invited_by") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_users")
}

model CompanyLocation {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  address         String?
  // Null when `nationwide` is set — whole-country coverage has no fixed city.
  city            String?
  region          String?
  country         String   @default("RO")
  lat             Float?
  lng             Float?
  isPrimary       Boolean  @default(false) @map("is_primary")
  serviceRadiusKm Int?     @map("service_radius_km")
  // Serves the whole country — `serviceRadiusKm` is null and the feed matches it
  // for any searched area (the km radius no longer applies).
  nationwide      Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_locations")
}

enum ContactType {
  phone
  whatsapp
  email
  url
}

model CompanyContact {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  type      ContactType
  value     String
  isPublic  Boolean     @default(true) @map("is_public")
  createdAt DateTime    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_contacts")
}

model CompanyService {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_services")
}

// ---------------------------------------------------------------------------
// Wallet & Credits (spec: "WALLET / CREDITS")
// Credits are the internal currency, EUR-denominated: 1 Credit = 1 EUR. Money
// is stored as integer minor units (hundredths of a credit = euro cents) to
// keep the ledger exact. The wallet is prepaid: balance can never go negative.
//
// One wallet per user — it funds every business the user owns. Individual
// campaigns have no balance of their own; each spend is tagged with the
// business it belongs to (`WalletTransaction.companyId`) for per-campaign
// consumption tracking.
// ---------------------------------------------------------------------------

model Wallet {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  // Hundredths of a credit. 1 Credit = 1 EUR, so this is also euro cents.
  balanceMinor  Int       @default(0) @map("balance_minor")
  currency      String    @default("EUR")
  // Admin freeze: while set, the wallet cannot be topped up or spent from
  // (campaigns can't activate, clicks aren't billed). Balance is preserved.
  blockedAt     DateTime? @map("blocked_at")
  blockedReason String?   @map("blocked_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

enum WalletTxnType {
  purchase
  spend
  refund
  adjustment
}

enum WalletTxnStatus {
  pending
  completed
  failed
  canceled
}

model WalletTransaction {
  id        String          @id @default(uuid()) @db.Uuid
  wallet    Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletId  String          @map("wallet_id") @db.Uuid
  // Which business this movement belongs to (spend attribution / per-campaign
  // consumption). Null for wallet-level events like credit purchases.
  company   Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?         @map("company_id") @db.Uuid
  type      WalletTxnType
  status    WalletTxnStatus @default(completed)

  // Signed minor units: positive = credit in, negative = debit out.
  // For a pending purchase the balance is not moved until it completes.
  amountMinor       Int  @map("amount_minor")
  balanceAfterMinor Int? @map("balance_after_minor")

  // Payment context (purchases). `fxRate` is the EUR->RON rate used at checkout.
  eurCents    Int?     @map("eur_cents")
  ronBani     Int?     @map("ron_bani")
  fxRate      Decimal? @map("fx_rate") @db.Decimal(10, 4)
  provider    String?
  providerRef String?  @map("provider_ref")

  // Rolled-up CPC ad-click billing: one row per (wallet, company, day) instead
  // of one per click. `spendDay` + the unique constraint below let the DB
  // itself guarantee that even two clicks landing in the same instant collapse
  // onto one row (an atomic upsert), not a race between a read and a write.
  spendDay   DateTime? @map("spend_day") @db.Date
  clickCount Int?      @map("click_count")

  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoice Invoice?

  @@unique([walletId, companyId, provider, spendDay])
  @@index([walletId, createdAt])
  @@index([companyId])
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// Billing profile + invoices — a client must declare who they are (Persoană
// fizică / Persoană juridică) before an invoice can be issued; a credit
// purchase is only ever confirmed once that profile is complete (wallet
// service gate), so a deposit without an invoice cannot happen. Invoices
// snapshot both the buyer and the issuer at issue time — they must never
// change retroactively when a profile is edited later.
// ---------------------------------------------------------------------------

enum BillingProfileKind {
  individual
  company
}

model BillingProfile {
  id     String             @id @default(uuid()) @db.Uuid
  userId String             @unique @map("user_id") @db.Uuid
  kind   BillingProfileKind

  // Full name (individual) or legal company name.
  name     String
  // CUI/CIF and Nr. Reg. Comerțului — company only.
  taxId    String? @map("tax_id")
  regCom   String? @map("reg_com")
  vatPayer Boolean @default(false) @map("vat_payer")

  address      String
  city         String
  county       String?
  postalCode   String? @map("postal_code")
  country      String  @default("RO")
  billingEmail String? @map("billing_email")
  iban         String?
  bankName     String? @map("bank_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_profiles")
}

/**
 * Gapless per-series-per-year invoice numbering (`{series}-{year}-{seq}`).
 */
model InvoiceCounter {
  series  String @id
  year    Int
  nextSeq Int    @default(1) @map("next_seq")

  @@map("invoice_counters")
}

model Invoice {
  id                  String   @id @default(uuid()) @db.Uuid
  number              String   @unique
  userId              String   @map("user_id") @db.Uuid
  walletTransactionId String   @unique @map("wallet_transaction_id") @db.Uuid
  issuedAt            DateTime @default(now()) @map("issued_at")

  // Buyer snapshot at issue time.
  buyerKind       BillingProfileKind @map("buyer_kind")
  buyerName       String             @map("buyer_name")
  buyerTaxId      String?            @map("buyer_tax_id")
  buyerRegCom     String?            @map("buyer_reg_com")
  buyerVatPayer   Boolean            @map("buyer_vat_payer")
  buyerAddress    String             @map("buyer_address")
  buyerCity       String             @map("buyer_city")
  buyerCounty     String?            @map("buyer_county")
  buyerPostalCode String?            @map("buyer_postal_code")
  buyerCountry    String             @map("buyer_country")
  buyerEmail      String?            @map("buyer_email")

  // Issuer snapshot (platform settings) at issue time.
  issuerName    String  @map("issuer_name")
  issuerTaxId   String? @map("issuer_tax_id")
  issuerRegCom  String? @map("issuer_reg_com")
  issuerAddress String  @map("issuer_address")
  issuerIban    String? @map("issuer_iban")
  issuerBank    String? @map("issuer_bank")

  currency      String   @default("RON")
  description   String
  subtotalMinor Int      @map("subtotal_minor")
  vatRatePct    Int      @map("vat_rate_pct")
  vatMinor      Int      @map("vat_minor")
  totalMinor    Int      @map("total_minor")
  eurCents      Int?     @map("eur_cents")
  fxRate        Decimal? @map("fx_rate") @db.Decimal(10, 4)

  // Admin management: an invoice is never edited or deleted (it's a fiscal
  // record) — an admin can only mark it void, with a reason, same shape as
  // the wallet freeze / user ban actions elsewhere in the admin panel.
  voidedAt   DateTime? @map("voided_at")
  voidReason String?   @map("void_reason")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletTransaction WalletTransaction @relation(fields: [walletTransactionId], references: [id])

  @@index([userId, issuedAt])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Campaign (spec: "Buget + CPC" / "APARI PRIMUL"). One per company for now.
// A company appears in the feed only while its campaign is `active`, and the
// wallet must hold at least one day's budget for it to run (prepaid).
// ---------------------------------------------------------------------------

enum CampaignStatus {
  draft
  active
  paused
  depleted
}

model Campaign {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @unique @map("company_id") @db.Uuid
  status    CampaignStatus @default(draft)

  // Minor units (hundredths of a credit), same convention as the wallet.
  dailyBudgetMinor Int     @map("daily_budget_minor")
  cpcMinor         Int     @map("cpc_minor")
  appearFirst      Boolean @default(false) @map("appear_first")
  // AUTO mode: the platform keeps the CPC just above the top competitor in the
  // category (bidding for feed position #1) and keeps the campaign running,
  // within the daily budget cap. Switches itself off if the campaign depletes.
  autoOptimize     Boolean @default(false) @map("auto_optimize")

  // CPC metering. `spentTodayMinor` is the credits burned on clicks for the UTC
  // day `spendDay`; both reset lazily when the day rolls over.
  spentTodayMinor      Int       @default(0) @map("spent_today_minor")
  spendDay             DateTime? @map("spend_day") @db.Date
  // `activatedAt` marks the start of the CURRENT active run (re-stamped on every
  // activation). `activeSecondsAccrued` banks the duration of all past runs, so
  // the Age Score counts only time the campaign was actually live — not
  // wall-clock time since it was first switched on.
  activatedAt          DateTime? @map("activated_at")
  activeSecondsAccrued Int       @default(0) @map("active_seconds_accrued")
  pausedAt             DateTime? @map("paused_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("campaigns")
}

// ---------------------------------------------------------------------------
// Ad click — one row per (company, visitor, UTC day). `visitor_hash` is
// sha256(ip | user-agent | companyId | yyyy-mm-dd) so the same person is billed
// at most once per day per listing (spam / repeat-click protection). Non-billed
// rows (`reason` set) still record the view for analytics.
// ---------------------------------------------------------------------------

model AdClick {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  visitorHash String   @map("visitor_hash")
  billed      Boolean  @default(false)
  costMinor   Int      @default(0) @map("cost_minor")
  // Why a click was not billed: no_campaign | bot | budget | insufficient
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, visitorHash])
  @@index([companyId, createdAt])
  @@map("ad_clicks")
}

// ---------------------------------------------------------------------------
// Lead — a request a visitor sent to a company from its generated site: a
// contact-form message or a tap on the "call" button. Shown in the company's
// panel ("Cereri"). `firstResponseAt` / `resolvedAt` capture how fast the
// company reacted — the raw material for the response-time ranking input.
// ---------------------------------------------------------------------------

enum LeadChannel {
  form
  call
}

enum LeadStatus {
  new
  seen
  resolved
}

model Lead {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  channel   LeadChannel
  status    LeadStatus  @default(new)

  // Visitor-supplied (form). For a `call` the visitor stays anonymous and
  // `phone` holds the company number that was dialed.
  name    String?
  email   String?
  phone   String?
  message String?

  // Privacy-safe dedupe / spam key: sha256(ip | ua | companyId | channel | window).
  visitorHash String @map("visitor_hash")

  // Response tracking (feeds the feed ranking later). `respondedVia` records how
  // the first response was logged: 'email' / 'phone' (owner tapped the visitor's
  // contact in the panel), 'quick_reply' (a reply sent straight from the panel),
  // or 'manual' (resolved without an explicit reply). `replyText` / `repliedAt`
  // hold that panel quick reply.
  firstResponseAt DateTime? @map("first_response_at")
  respondedVia    String?   @map("responded_via")
  replyText       String?   @map("reply_text")
  repliedAt       DateTime? @map("replied_at")
  resolvedAt      DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, visitorHash])
  @@index([companyId, status, createdAt])
  @@index([companyId, channel])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Platform settings — small key/value config the platform can change without a
// deploy (e.g. the EUR/RON rate used when charging in lei). Never hardcoded.
// ---------------------------------------------------------------------------

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Support — a lightweight ticketing system. Any signed-in user can open a
// ticket; platform staff (admin / support roles) work the queue. The thread is
// a flat list of messages: `reply` (visible to everyone on the ticket),
// `note` (internal, staff-only) and `system` (status/assignment events).
// ---------------------------------------------------------------------------

enum SupportTicketStatus {
  open
  in_progress
  waiting
  resolved
  closed
}

enum SupportTicketPriority {
  low
  normal
  high
  urgent
}

enum SupportTicketCategory {
  bug
  problem
  question
  billing
  feedback
  other
}

enum SupportMessageKind {
  reply
  note
  system
}

model SupportTicket {
  id      String @id @default(uuid()) @db.Uuid
  // Human-friendly running number shown as "#1042".
  number  Int    @unique @default(autoincrement())
  subject String

  status   SupportTicketStatus   @default(open)
  priority SupportTicketPriority @default(normal)
  category SupportTicketCategory @default(other)

  requesterId String  @map("requester_id") @db.Uuid
  assigneeId  String? @map("assignee_id") @db.Uuid
  // Optional: the business the ticket is about.
  companyId   String? @map("company_id") @db.Uuid

  firstResponseAt DateTime? @map("first_response_at")
  resolvedAt      DateTime? @map("resolved_at")
  closedAt        DateTime? @map("closed_at")
  lastActivityAt  DateTime  @default(now()) @map("last_activity_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  requester User             @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee  User?            @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  company   Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  messages  SupportMessage[]

  @@index([status])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([lastActivityAt])
  @@map("support_tickets")
}

model SupportMessage {
  id       String             @id @default(uuid()) @db.Uuid
  ticketId String             @map("ticket_id") @db.Uuid
  authorId String?            @map("author_id") @db.Uuid
  kind     SupportMessageKind @default(reply)
  body     String

  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
