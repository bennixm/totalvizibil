// Totalvizibil — database schema.
// Milestone 1 (Company Foundation): a faithful subset of PRD §16.1–16.3.
// Later milestones add websites, campaigns, ledger, analytics, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  status       UserStatus @default(active)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions       Session[]
  platformRoles  PlatformRoleAssignment[]
  companyMembers CompanyUser[]
  ownedCompanies Company[]               @relation("CompanyOwner")

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum PlatformRole {
  admin
  support
  finance
  moderator
}

model PlatformRoleAssignment {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      PlatformRole
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("platform_roles")
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  slug      String   @unique
  // { "ro": "...", "en": "...", "de": "..." }
  nameI18n  Json     @map("name_i18n")
  icon      String?
  isActive  Boolean  @default(true) @map("is_active")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  companies Company[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Company
// ---------------------------------------------------------------------------

enum CompanyStatus {
  draft
  active
  suspended
}

model Company {
  id           String        @id @default(uuid()) @db.Uuid
  legalName    String?       @map("legal_name")
  displayName  String        @map("display_name")
  slug         String        @unique
  description  String?
  categoryId   String?       @map("category_id") @db.Uuid
  logoUrl      String?       @map("logo_url")
  status       CompanyStatus @default(draft)
  country      String        @default("RO")
  defaultLocale String       @default("ro") @map("default_locale")
  currency     String        @default("RON")
  ownerUserId  String        @map("owner_user_id") @db.Uuid
  claimedAt    DateTime?     @map("claimed_at")

  // Feed ranking inputs (PRD §8). Cached, recomputed on profile changes.
  // `featured` stands in for "has an active sponsored campaign" until the
  // campaigns/credit tables land — it only drives the "sponsored" placement slot.
  qualityScore Float   @default(0) @map("quality_score")
  featured     Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category  Category?         @relation(fields: [categoryId], references: [id])
  owner     User              @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  members   CompanyUser[]
  locations CompanyLocation[]
  contacts  CompanyContact[]
  services  CompanyService[]
  website   Website?

  @@index([ownerUserId])
  @@index([categoryId])
  @@index([status])
  @@map("companies")
}

// ---------------------------------------------------------------------------
// Website (PRD §11) — one per company. Content is a typed block tree stored
// as JSON for now; normalised page/section tables come in a later milestone.
// ---------------------------------------------------------------------------

enum WebsiteMode {
  easy
  advanced
}

enum WebsiteStatus {
  draft
  published
  unpublished
}

model Website {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @unique @map("company_id") @db.Uuid
  mode      WebsiteMode   @default(easy)
  status    WebsiteStatus @default(draft)
  // { palette, fontPair, radius, density }
  theme     Json
  // { pages: [{ slug, title, isHome, sections: [{ type, ...content }] }], seo: {...} }
  content   Json
  generator String        @default("rule-based-v1")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("websites")
}

// Anonymous, pre-account website draft. Created by the "Create your business"
// flow before registration; claimed into a real Company + Website on sign-up.

enum WebsiteDraftStatus {
  generating
  ready
  claimed
  abandoned
}

model WebsiteDraft {
  id               String             @id @default(uuid()) @db.Uuid
  token            String             @unique
  mode             WebsiteMode        @default(easy)
  status           WebsiteDraftStatus @default(ready)
  // Raw user answers from the Easy/Advanced form.
  input            Json
  // Generated block tree (same shape as Website.content).
  content          Json
  theme            Json
  generator        String             @default("rule-based-v1")
  claimedCompanyId String?            @map("claimed_company_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("website_drafts")
}

enum CompanyRole {
  owner
  manager
  editor
  billing
}

enum CompanyMemberStatus {
  active
  invited
  removed
}

model CompanyUser {
  id        String              @id @default(uuid()) @db.Uuid
  companyId String              @map("company_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  role      CompanyRole
  status    CompanyMemberStatus @default(active)
  invitedBy String?             @map("invited_by") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_users")
}

model CompanyLocation {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  address         String?
  city            String
  region          String?
  country         String   @default("RO")
  isPrimary       Boolean  @default(false) @map("is_primary")
  serviceRadiusKm Int?     @map("service_radius_km")
  createdAt       DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_locations")
}

enum ContactType {
  phone
  whatsapp
  email
  url
}

model CompanyContact {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  type      ContactType
  value     String
  isPublic  Boolean     @default(true) @map("is_public")
  createdAt DateTime    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_contacts")
}

model CompanyService {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_services")
}
